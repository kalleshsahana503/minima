{
  "manifest_version": 3,
  "name": "Minima – Your Agentic Assistant",
  "version": "1.0.0",
  "description": "A floating assistant on every website: it reads the page you are on, answers questions about your open apps/tabs, finds things and fills forms. It asks before anything important.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "activeTab",
    "offscreen"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Minima",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "toggle-navi": {
      "suggested_key": {
        "default": "Alt+N"
      },
      "description": "Open or close Minima"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "exclude_matches": [
        "*://*.facebook.com/*",
        "*://*.messenger.com/*",
        "*://*.fb.com/*",
        "*://*.fb.me/*"
      ],
      "js": [
        "shared.js",
        "page.js",
        "overlay.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}