# START-HERE.bat opens this file for you the first time. Replace the text after = with your own key
# from https://console.groq.com/keys  (looks like gsk_ followed by letters and numbers).
# No quotes, no spaces around the = sign. Never share or upload this file.
GROQ_API_KEY=paste-your-groq-key-here

# Optional
# Minima picks a Groq model that works for your key by itself. Only set these to force a choice:
# NAVI_MODEL=openai/gpt-oss-120b
# NAVI_FALLBACK_MODELS=openai/gpt-oss-20b
# NAVI_MAX_STEPS=22
# NAVI_EMBEDDINGS=fastembed          # or huggingface
# NAVI_DATA_DIR=C:/navi-data         # default is your user folder, outside OneDrive
# NAVI_TOKEN=some-secret             # if set, put the same value in the extension's Settings
# Speed
# NAVI_REASONING=low                 # low = fastest answers. medium/high = slower but a bit smarter
# NAVI_MODEL=openai/gpt-oss-120b     # smarter but slower than the default gpt-oss-20b
# NAVI_TPM_BUDGET=60000              # ONLY if you pay for Groq (Developer plan): removes the "pausing" waits

# ---- Want the strongest answers? Use Anthropic's Claude models instead of Groq (paid, no free-tier limits).
# 1) Get a key at https://console.anthropic.com/settings/keys and add credit.  2) Remove the # from the 3 lines below.
# 3) Close the black window and run START-HERE.bat again (it installs one extra package the first time).
# NAVI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=paste-your-anthropic-key-here
# NAVI_ANTHROPIC_MODEL=claude-sonnet-5-5     # smart and quick. claude-opus-5-5 is smarter but slower and dearer.
